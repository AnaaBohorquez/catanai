# Orígenes autorizados para CORS, separados por coma
CORS_ORIGINS=http://localhost:4200,http://localhost:8080

# Dónde vive el modelo entrenado
RUTA_MODELO=./modelos/colono.joblib

# En Render poner ENTORNO=produccion: así no se escribe logs/consumo.jsonl.
ENTORNO=desarrollo

# Asistente conversacional. Sin clave, el chat responde con plantillas.
# La clave NUNCA va en el repositorio: solo en backend/.env (ignorado) o en Render.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# minimal, low, medium o high. Elegirlo con scripts/evaluar_chat.py.
OPENAI_ESFUERZO=minimal

# Límites del chat público.
CHAT_MAX_OUTPUT_TOKENS=1200
CHAT_MAX_RONDAS=4
CHAT_PREGUNTAS_POR_IP=15
CHAT_VENTANA_S=600
CHAT_PRESUPUESTO_DIARIO_USD=1.0
